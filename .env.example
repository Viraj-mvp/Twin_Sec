# TwinSec Environment Configuration

# Database
DB_PATH=./data/twinsec.db
SESSION_SECRET=32_byte_random_hex_secret_here
NODE_ENV=development

# Multi-Provider AI Gateway Keys (All Free Tier Compatible)

# 1. Groq (fastest — terminal commands, hints)
#    Sign up: https://console.groq.com (14,400 requests/day free)
GROQ_API_KEY=gsk_your_groq_key_here

# 2. Cerebras (ultra-fast inference — debrief scorecards, narration)
#    Sign up: https://inference.cerebras.ai (Free tier available)
CEREBRAS_API_KEY=csk_your_cerebras_key_here

# 3. Google Gemini (large context — espionage briefings, adversary chat)
#    Sign up: https://aistudio.google.com (15 RPM, 1M tokens/day free)
GEMINI_API_KEY=AIza_your_gemini_key_here

# 4. OpenRouter (fallback — free models available)
#    Sign up: https://openrouter.ai (Free models: llama-3.1-8b:free, gemma-3-12b:free)
OPENROUTER_API_KEY=sk-or_your_openrouter_key_here

# 5. Local Ollama (Offline fallback)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
